{
  "manifest_version": 3,
  "name": "Paradise License Admin",
  "description": "Paradise License Admin Dashboard — Commercial Secure",
  "version": "1.2.0",
  "action": {
    "default_popup": "index.html",
    "default_title": "Paradise License Admin"
  },
  "icons": {
    "128": "icon_128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
